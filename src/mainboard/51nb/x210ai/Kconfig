if BOARD_51NB_X210AI

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_32768
	select CONSOLE_CBMEM
	select FSP_TYPE_IOT
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select INTEL_GMA_HAVE_VBT
	select INTEL_LPSS_UART_FOR_CONSOLE
	select NO_UART_ON_SUPERIO
	select SOC_INTEL_COMMON_BLOCK_HDA_VERB
	select SOC_INTEL_CRASHLOG
	select SOC_INTEL_METEORLAKE_U_H
	select SOC_INTEL_ENABLE_USB4_PCIE_RESOURCES
	select SPD_READ_BY_WORD
	select SYSTEM_TYPE_LAPTOP

config MAINBOARD_DIR
	default "51nb/x210ai"

config MAINBOARD_PART_NUMBER
	default "X210AI"

config MAINBOARD_SMBIOS_PRODUCT_NAME
	default "X210AI"

config MAINBOARD_VERSION
	default "1.0"

config CONSOLE_POST
	default y

config DIMM_SPD_SIZE
	default 1024	# ddr5 spd5 hub needs >= 1024

config FMDFILE
	default "src/mainboard/\$(CONFIG_MAINBOARD_DIR)/board.fmd"

config UART_FOR_CONSOLE
	default 0

config USE_PM_ACPI_TIMER
	default n

# tme's per-boot dram key doesn't survive s3, so leaving INTEL_TME on breaks
# resume. it defaults on for meteor lake, so force it off.
config INTEL_TME
	default n

endif
